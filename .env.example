# Base de datos PostgreSQL
POSTGRES_DB=inmobiliaria
POSTGRES_USER=inmobiliaria
POSTGRES_PASSWORD=inmobiliaria_segura
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://inmobiliaria:inmobiliaria_segura@localhost:5432/inmobiliaria?schema=public

# Backend
PORT=4000
API_HOST_PORT=4000
WEB_HOST_PORT=3000
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=cambie_esta_clave_por_una_muy_segura
JWT_EXPIRES_IN_SECONDS=86400
PUBLIC_API_URL=http://localhost:4000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000

# Storage S3-compatible (MinIO local o proveedor externo futuro)
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_BUCKET=inmobiliaria-assets
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
STORAGE_AUTO_CREATE_BUCKET=true
STORAGE_MAX_FILE_SIZE=25000000
STORAGE_MAX_FILE_COUNT=20
STORAGE_MAX_REQUEST_SIZE=70000000
CONTRACT_MAX_FILE_SIZE=25000000
PROPERTY_IMAGE_MAX_FILE_SIZE=5000000
PROPERTY_360_MAX_FILE_SIZE=15000000

# Pagos: use mock, wompi o cybervestigio.
PAYMENT_PROVIDER=mock
WOMPI_PUBLIC_KEY=pub_test_reemplace_con_su_llave
WOMPI_INTEGRITY_SECRET=test_integrity_reemplace_con_su_secreto
WOMPI_EVENTS_SECRET=test_events_reemplace_con_su_secreto
WOMPI_REDIRECT_URL=http://localhost:3000/mi-cuenta
CYBERVESTIGIO_CHECKOUT_URL=https://cybervestigio.com/pagos
CYBERVESTIGIO_RETURN_URL=http://localhost:3000/mi-cuenta

# Integración BUIJO: n8n + Outlook + Bancolombia
N8N_PAYMENTS_API_KEY=genere_una_clave_larga_y_unica
BANCOLOMBIA_ALLOWED_SENDERS=remitente-verificado@bancolombia.com.co
BANCOLOMBIA_ACCOUNT_LAST4=1234
PAYMENT_AMOUNT_TOLERANCE_COP=0
PAYMENT_NAME_SCORE_MIN=72
PAYMENT_NAME_SCORE_MARGIN=12
IMPORT_ADMIN_EMAIL=admin@asesoriainmobiliariajb.com
IMPORT_CREATE_CURRENT_INVOICES=true
